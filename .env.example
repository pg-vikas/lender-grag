PORT=5000
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/lender_greg
DATABASE_SSL=false

APP_NAME="Lender Greg"
APP_URL=http://localhost:5000

# SMTP server settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Outgoing mail metadata
SMTP_FROM_NAME=Lender Greg
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_TO_EMAIL=greg@example.com

# Session and auth settings
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_NAME=lg.sid
SESSION_TABLE_NAME=user_sessions
SESSION_TTL_MS=28800000

# Optional bootstrap admin account
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=
ADMIN_PASSWORD=replace_with_a_strong_admin_password
